{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r00tbear/project-context-skill/schemas/findings.schema.json",
  "title": "project-context findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "auditor", "scanned_at", "scope", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "auditor": {"$ref": "#/$defs/auditor"},
    "scanned_at": {"type": "string", "format": "date-time"},
    "scope": {"$ref": "#/$defs/scope"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "auditor": {"enum": ["stack", "architecture", "ui", "data", "bloat", "security", "testing", "greenfield"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\n\\r\\u0000]).+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "unscanned"],
      "properties": {
        "included": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "excluded": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "unscanned": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "detail"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "line": {"type": "integer", "minimum": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "assertion"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "assertion": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "counterevidence", "note"],
      "properties": {
        "status": {"enum": ["pending", "not-required", "confirmed", "downgraded", "refuted"]},
        "resulting_severity": {
          "anyOf": [{"$ref": "#/$defs/severity"}, {"type": "null"}]
        },
        "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "note": {"type": "string"}
      },
      "if": {"properties": {"status": {"enum": ["downgraded", "refuted"]}}},
      "then": {"properties": {"counterevidence": {"minItems": 1}}}
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "severity", "confidence", "identity", "status", "evidence", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+-[0-9]{3,}$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "identity": {"$ref": "#/$defs/identity"},
        "status": {"enum": ["new", "persisting", "resolved", "refuted"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "verification": {"$ref": "#/$defs/verification"}
      },
      "if": {"properties": {"severity": {"enum": ["high", "critical"]}}},
      "then": {
        "properties": {
          "verification": {
            "properties": {"status": {"enum": ["pending", "confirmed", "downgraded", "refuted"]}}
          }
        }
      }
    }
  }
}
